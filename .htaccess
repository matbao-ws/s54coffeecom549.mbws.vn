# Set UTF-8
AddDefaultCharset UTF-8

<FilesMatch "\.php$">
    SetHandler "proxy:unix:///run/plesk/plesk-php82-fpm.sock|fcgi://localhost"
</FilesMatch>

DirectoryIndex public/index.php index.php

# Enable URL Rewriting for Clean URLs
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle Authorization & CSRF Headers
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteCond %{HTTP:x-xsrf-token} .
  RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

  # SEO: 301 Permanent Redirect from staging domain to official domain s54coffee.com
  RewriteCond %{HTTP_HOST} ^s54coffeecom549\.mbws\.vn$ [NC]
  RewriteCond %{REQUEST_URI} !^/google[0-9a-f]+\.html$ [NC]
  RewriteRule ^(.*)$ https://s54coffee.com/$1 [R=301,L]

# Static asset mappings
  RewriteRule ^(.*/)?assets/(.*)$ assets/$2 [L]
  RewriteRule ^admin-assets/(.*)$ public/admin-assets/$1 [L]
  RewriteRule ^client-assets/(.*)$ public/client-assets/$1 [L]
  RewriteRule ^storage/(?!app/public/)(.*)$ storage/app/public/$1 [L]


  # SEO: Route sitemap.xml and robots.txt through Laravel for dynamic generation
  RewriteRule ^/*sitemap\.xml$ public/index.php [L,QSA]
  RewriteRule ^/*robots\.txt$ public/index.php [L,QSA]

  # Serve existing static asset files directly (images, fonts, stylesheets, scripts, videos, php runners)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_URI} \.(php|css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot|mp4|pdf)$ [NC]
  RewriteRule ^ - [L]

  # Explicit 301 redirects for legacy static HTML files to canonical Laravel client routes
  RewriteRule ^wholesale\.html$ /vi/pages/wholesale [R=301,L]
  RewriteRule ^our-story\.html$ /vi/pages/our-story [R=301,L]
  RewriteRule ^contact\.html$ /vi/lien-he [R=301,L]
  RewriteRule ^contact$ /vi/lien-he [R=301,L]
  RewriteRule ^lien-he\.html$ /vi/lien-he [R=301,L]
  RewriteRule ^lien-he$ /vi/lien-he [R=301,L]
  RewriteRule ^collections-coffee\.html$ /vi/san-pham [R=301,L]
  RewriteRule ^(.*/)?checkout\.html$ /vi/checkout [R=301,L]
  RewriteRule ^(.*/)?cart\.html$ /vi/cart [R=301,L]

  # Allow explicit standalone HTML tools/checkouts if requested directly (e.g. /checkout.html)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_URI} \.html$ [NC]
  RewriteCond %{REQUEST_URI} !^/index\.html$ [NC]
  RewriteRule ^ - [L]

  # Route all other requests through Laravel
  RewriteRule ^ public/index.php [L,QSA]
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml font/woff font/woff2
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Custom Error Document
ErrorDocument 404 /404.html
